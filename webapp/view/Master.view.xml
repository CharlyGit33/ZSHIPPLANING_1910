<mvc:View
	controllerName="ar.com.relesa.shipment.planning.controller.Master"
	xmlns="sap.m"
	xmlns:semantic="sap.f.semantic"
	xmlns:mvc="sap.ui.core.mvc">

	<semantic:SemanticPage
		id="masterPage"
		preserveHeaderStateOnScroll="true"
		toggleHeaderOnTitleClick="false">
		<semantic:titleHeading>
			<Title
				id="masterPageTitle"
				text="{masterView>/title}"
				level="H2"/>
		</semantic:titleHeading>
		<semantic:content>
		
			<!-- For client side filtering add this to the items attribute: parameters: {operationMode: 'Client'}}" -->
			<List
				id="list"
				width="100%"
				class="sapFDynamicPageAlignContent"
				items="{shipments>/}"
				busyIndicatorDelay="{masterView>/delay}"
				busy="{masterView>/busy}"
				noDataText="{masterView>/noDataText}"
				mode="{= ${device>/system/phone} ? 'None' : 'SingleSelectMaster'}"
				growing="true"
				growingScrollToLoad="true"
				updateFinished=".onUpdateFinished"
				selectionChange=".onSelectionChange">
				<headerToolbar>
					<OverflowToolbar height="auto">
						<VBox>
						<Button text="Con Faltantes" type="Reject" press="onMostrarFaltantes"/>
						<!-- <SearchField
							showRefreshButton="false"
							tooltip="{i18n>masterSearchTooltip}"
							search=".onSearch"
							value="{filterModel>/individual/shipmentId}"
							width="auto">
							<layoutData>
								<OverflowToolbarLayoutData
									minWidth="150px"
									maxWidth="240px"
									shrinkable="true"
									priority="NeverOverflow"/>
							</layoutData>
						</SearchField>					 -->	
						</VBox>
						<ToolbarSpacer/>
						<Button
							press=".onFilterConfirm"
							icon="sap-icon://synchronize"
							type="Transparent"/>
						<Button
							press=".onFilterPress"
							tooltip="{i18n>master.filter.tooltip}"
							icon="sap-icon://filter"
							type="Transparent"/>
					</OverflowToolbar>
				</headerToolbar>
				<items>
                    <ObjectListItem type="Navigation" press=".onSelectionChange" title="{shipments>forwardingAgentName}" number="{shipments>shipmentId}">
                        <firstStatus>
                            <ObjectStatus text="{shipments>yardStatusDescription}" state="{path: 'shipments>yardStatus', formatter: '.formatter.getYardStatusState'}" inverted="{path: 'shipments>yardStatus', formatter: '.formatter.getYardStatusInverted'}" />
                        </firstStatus>
                        <attributes>
                            <ObjectAttribute  text="{i18n>shipment.checkedQuantity.label}: {shipments>mixPalletsCheckedQuantity} / {shipment>mixPalletsQuantity}" visible="{= ${shipments>yardStatus} === 'pending'}"/>
                            <ObjectAttribute  text="{= ${i18n>shipment.pickedUpQuantity.label} + ': ' + ${shipments>palletsPickedUpQuantity}.toString() + ' / ' + (${shipments>mixPalletsQuantity} + ${shipments>purePalletsQuantity}).toString()}" visible="{= ${shipments>yardStatus} === 'checked'}"/>
                            <ObjectAttribute  text="{shipments>truck}"/>
                        </attributes>
                    </ObjectListItem>
				</items>
			</List>
		</semantic:content>
	</semantic:SemanticPage>
</mvc:View>