                />

                <Button
                    text="{i18n>palletDetail.upload.button.text}"
                    busyIndicatorDelay="0"
                    icon="sap-icon://upload"
                    press=".onPalletCheckSwitch"
                    visible="{= ${palletView>/yardStatus} === 'checked' &amp;&amp; (${ShipmentService>palletStatus} === 'checked' || ${ShipmentService>palletStatus} === 'pending')}"
                />
                <Button
                    text="{i18n>palletDetail.download.button.text}"
                    busyIndicatorDelay="0"
                    icon="sap-icon://download"
                    press=".onPalletUncheckSwitch"
                    visible="{= ${palletView>/yardStatus} === 'checked' &amp;&amp; ${ShipmentService>palletStatus} !== 'checked' &amp;&amp; ${ShipmentService>palletStatus} !== 'pending'}"
                />

                <Button
                    text="{i18n>palletDetail.checkOut.button.text}"
                    busyIndicatorDelay="0"
                    icon="sap-icon://shipping-status"
                    press=".onPalletCheckSwitch"
                    visible="{= ${palletView>/yardStatus} === 'invoiced' &amp;&amp; ${ShipmentService>palletStatus} === 'invoiced'}"
                />
                <Button
                    text="{i18n>palletDetail.undo.button.text}"
                    busyIndicatorDelay="0"
                    icon="sap-icon://undo"
                    press=".onPalletUncheckSwitch"
                    visible="{= ${palletView>/yardStatus} === 'invoiced' &amp;&amp; ${ShipmentService>palletStatus} === 'checkedOut'}"
                />
            </OverflowToolbar>
        </f:footer>
    </f:DynamicPage>
</mvc:View>
