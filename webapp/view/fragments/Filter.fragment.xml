<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:f="sap.ui.layout.form" xmlns:l="sap.ui.layout">
    <Dialog title="{i18n>filter.title}" contentWidth="20%">
        <content>
            <f:Form editable="true">
                <f:layout>
                    <f:ResponsiveGridLayout labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="12" adjustLabelSpan="false" emptySpanXL="0" emptySpanL="0"
						emptySpanM="0" emptySpanS="0" columnsXL="1" columnsL="1" columnsM="1" singleContainerFullSize="false"/>
                </f:layout>
                <f:formContainers>
                    <f:FormContainer>
                        <f:formElements>
                            <f:FormElement label="{ShipmentService>/#planningShipment/shipmentDate/@sap:label}">
                                <f:fields>
                                    <DatePicker id="filter.planningShipment.shipmentDate" dateValue="{filterModel>/multiples/shipmentDate}" displayFormat="dd/MM/yyyy" />
                                </f:fields>
                            </f:FormElement>
<!--                             <f:FormElement label="{ShipmentService>/#planningShipment/forwardingAgentId/@sap:label}">
                                <f:fields>
                                    <Input id="filter.planningShipment.forwardingAgentId"
                                        showSuggestion="true"
                                        suggest=".onSuggest"
                                        suggestionItemSelected=".onSuggestionItemSelected"
                                        suggestionItems="{vendor>/vendors}">
                                        <suggestionItems>
                                            <core:Item key="{vendor>vendorId}" text="{vendor>vendorName}" />
                                        </suggestionItems>
                                    </Input>
                                </f:fields>
                            </f:FormElement> -->
                            <f:FormElement label="{ShipmentService>/#planningShipment/salesOrganizationId/@sap:label}">
                                <f:fields>
                                    <MultiComboBox id="filter.planningShipment.salesOrganizationId" items="{location>/salesOrganizations}"
                                        selectedKeys="{filterModel>/multiples/salesOrganizationId}">
                                        <core:Item key="{location>salesOrganizationId}" text="{location>description}" />
                                    </MultiComboBox>
                                </f:fields>
                            </f:FormElement> 
                            <f:FormElement label="Transportadora">
                                <f:fields>
                                    <MultiComboBox id="filter.planningShipment.salesOrganizationId2" items="{location>/transportadoraSet}"
                                        selectedKeys="{filterModel>/multiples/forwardingAgentName}">
                                        <core:Item key="{location>NOMBRE_TRANS}" text="{location>NOMBRE_TRANS}"/>
                                    </MultiComboBox>
                                </f:fields>
                            </f:FormElement>
                            <f:FormElement label="{ShipmentService>/#planningShipment/yardStatus/@sap:label}">
                                <f:fields>
                                    <MultiComboBox id="filter.planningShipment.yardStatus" items="{path: 'shipmentStatus>/statuses',
                                     filters : [
                                            { path : 'statusId', operator : 'EQ', value1 : ''},
                                            { path : 'statusId', operator : 'EQ', value1 : 'inCheck'},
                                            { path : 'statusId', operator : 'EQ', value1 : 'checked'},
                                            { path : 'statusId', operator : 'EQ', value1 : 'pickingUp'},
                                            { path : 'statusId', operator : 'EQ', value1 : 'pickedUp'},
                                            { path : 'statusId', operator : 'EQ', value1 : 'invoiced'},
                                            { path : 'statusId', operator : 'EQ', value1 : 'checkedOut'}
                                        ]}"
                                        selectedKeys="{filterModel>/multiples/yardStatus}">
                                        <core:Item key="{shipmentStatus>statusId}" text="{shipmentStatus>statusDescription}"/>
                                    </MultiComboBox>
                                </f:fields>
                            </f:FormElement>
                        </f:formElements>
                    </f:FormContainer>
                </f:formContainers>
            </f:Form>
        </content>
        <beginButton>
            <Button text="{i18n>filter.button.confirm}" icon="sap-icon://search" type="Emphasized" press=".onFilterConfirm"/>
        </beginButton>
        <endButton>
            <Button text="{i18n>filter.button.cancel}" icon="sap-icon://sys-cancel" type="Reject" press=".onFilterCancel"/>
        </endButton>
    </Dialog>
</core:FragmentDefinition>