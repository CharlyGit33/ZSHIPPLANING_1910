<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core">
	<ViewSettingsDialog
		confirm=".onGroupConfirmPress">
		<groupItems>
			<ViewSettingsItem text="{ShipmentService>/#palletComponent/materialFamily/@sap:label}" key="materialFamily" selected="true" />
